{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "regalo-invisible",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SORTEO",
        "class_name": "Sorteo"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-sorteo-sqlite",
      "new_sqlite_classes": [
        "Sorteo"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "SORTEO",
          "class_name": "Sorteo"
        }
      ]
    }
  }
}
